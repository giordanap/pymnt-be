# Copy this file to .env and fill in the values before running Docker Compose.
# .env is git-ignored — never commit real secrets.

# --- Postgres credentials (used by both the postgres service and the api service) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=challenge_db

# --- API ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# DATABASE_URL is assembled by docker-compose.yml from the Postgres vars above.
# For local pnpm dev (outside Docker), set this in apps/api/.env instead:
#   DATABASE_URL=postgresql://admin:supersecret@localhost:55432/challenge_db