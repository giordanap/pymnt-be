# Application
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (individual vars)
DB_HOST=localhost
DB_PORT=55432
DB_USER=
DB_PASSWORD=
DB_NAME=challenge_db

# Prisma connection string
# Local (pnpm dev):  postgresql://admin:supersecret@localhost:55432/challenge_db
# Docker Compose:    injected automatically by docker-compose.yml (uses service name 'postgres')
DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/challenge_db