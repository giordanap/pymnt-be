# Copy this file to apps/api/.env for local pnpm dev (outside Docker).
# When using Docker Compose, these values are injected automatically from the root .env.

# Server port
PORT=3001

# Allowed CORS origin
CORS_ORIGIN=http://localhost:3000

# Prisma connection string
# Local (pnpm dev): point to the Docker-exposed Postgres port
DATABASE_URL=postgresql://admin:supersecret@localhost:55432/challenge_db